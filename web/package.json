{
  "name": "Real Time Temp Humidity Monitor",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "css:watch": "postcss src/public/css/input.css -o src/public/css/output.css --watch",
    "build": "tsc && npm run copy-assets",
    "copy-assets": "xcopy src\\views dist\\views /E /I /Y && xcopy src\\public dist\\public /E /I /Y",
    "start": "node dist/app.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "mqtt": "^5.15.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "tailwindcss": "^4.1.18",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
