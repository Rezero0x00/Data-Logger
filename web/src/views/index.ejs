<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lab Monitoring System</title>
  <link href="/css/output.css" rel="stylesheet">
  <script src="/js/chart.umd.min.js"></script>
</head>
<body class="min-h-screen bg-slate-100 p-5 flex flex-col gap-3">

  <!-- Topbar -->
  <div class="flex items-center justify-between flex-wrap gap-3">
    <div>
      <h1 class="text-sm font-medium text-slate-800">Lab Environment Monitor</h1>
      <p class="text-xs text-slate-400 mt-0.5 uppercase tracking-widest">Real-time sensor dashboard</p>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <span class="inline-flex items-center gap-1.5 text-xs bg-emerald-50 text-emerald-600 border border-emerald-200 px-3 py-1 rounded-full">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Live
      </span>
      <button onclick="saveCSV()" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 active:scale-95 transition-all cursor-pointer">
        ↓ CSV
      </button>
      <button onclick="saveJSON()" class="inline-flex items-center gap-1.5 text-xs font-medium px-3 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-700 hover:bg-slate-50 active:scale-95 transition-all cursor-pointer">
        {} JSON
      </button>
    </div>
  </div>

  <!-- Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">

    <!-- Temperature -->
    <div class="bg-white border border-slate-200 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-400 uppercase tracking-widest">Temperature</span>
        <div class="w-7 h-7 rounded-lg bg-red-50 flex items-center justify-center">
          <span class="text-red-400 text-xs">°C</span>
        </div>
      </div>
      <div>
        <span class="text-3xl font-medium text-slate-800" id="temp">--</span>
        <span class="text-sm text-slate-400 font-normal"> °C</span>
      </div>
      <div class="text-xs text-slate-400 mt-1" id="temp-delta">—</div>
      <div class="mt-2 pt-2 border-t border-slate-100 flex justify-between text-xs text-slate-400">
        <span>↓ <span id="temp-min">--</span></span>
        <span>avg <span id="temp-avg">--</span></span>
        <span>↑ <span id="temp-max">--</span></span>
      </div>
    </div>

    <!-- Humidity -->
    <div class="bg-white border border-slate-200 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-400 uppercase tracking-widest">Humidity</span>
        <div class="w-7 h-7 rounded-lg bg-blue-50 flex items-center justify-center">
          <span class="text-blue-400 text-xs">%</span>
        </div>
      </div>
      <div>
        <span class="text-3xl font-medium text-slate-800" id="hum">--</span>
        <span class="text-sm text-slate-400 font-normal"> %</span>
      </div>
      <div class="text-xs text-slate-400 mt-1" id="hum-delta">—</div>
      <div class="mt-2 pt-2 border-t border-slate-100 flex justify-between text-xs text-slate-400">
        <span>↓ <span id="hum-min">--</span></span>
        <span>avg <span id="hum-avg">--</span></span>
        <span>↑ <span id="hum-max">--</span></span>
      </div>
    </div>

    <!-- Pressure -->
    <div class="bg-white border border-slate-200 rounded-xl p-4">
      <div class="flex items-center justify-between mb-2">
        <span class="text-xs text-slate-400 uppercase tracking-widest">Pressure</span>
        <div class="w-7 h-7 rounded-lg bg-violet-50 flex items-center justify-center">
          <span class="text-violet-400 text-xs">hPa</span>
        </div>
      </div>
      <div>
        <span class="text-3xl font-medium text-slate-800" id="press">--</span>
        <span class="text-sm text-slate-400 font-normal"> hPa</span>
      </div>
      <div class="text-xs text-slate-400 mt-1" id="press-delta">—</div>
      <div class="mt-2 pt-2 border-t border-slate-100 flex justify-between text-xs text-slate-400">
        <span>↓ <span id="press-min">--</span></span>
        <span>avg <span id="press-avg">--</span></span>
        <span>↑ <span id="press-max">--</span></span>
      </div>
    </div>

  </div>

  <!-- Chart -->
  <div class="bg-white border border-slate-200 rounded-xl p-4">
    <div class="flex gap-2 mb-3 flex-wrap">
      <button class="tab-btn active text-xs px-3 py-1 rounded-full border border-slate-200 text-slate-500 hover:bg-slate-800 hover:text-white hover:border-slate-800 transition-all cursor-pointer" onclick="switchTab(this,'temperature')">Temperature</button>
      <button class="tab-btn text-xs px-3 py-1 rounded-full border border-slate-200 text-slate-500 hover:bg-slate-800 hover:text-white hover:border-slate-800 transition-all cursor-pointer" onclick="switchTab(this,'humidity')">Humidity</button>
      <button class="tab-btn text-xs px-3 py-1 rounded-full border border-slate-200 text-slate-500 hover:bg-slate-800 hover:text-white hover:border-slate-800 transition-all cursor-pointer" onclick="switchTab(this,'pressure')">Pressure</button>
    </div>
    <div class="h-20 relative">
      <canvas id="chart"></canvas>
    </div>
  </div>

  <!-- Log Table -->
  <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
      <span class="text-sm font-medium text-slate-700">Reading log</span>
      <span class="text-xs text-slate-400" id="row-count">Waiting for sensor...</span>
    </div>
    <div class="max-h-48 overflow-y-auto">
      <table class="w-full border-collapse text-xs">
        <thead>
          <tr class="bg-slate-50">
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">#</th>
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">Time</th>
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">Temp</th>
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">Humidity</th>
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">Pressure</th>
            <th class="px-4 py-2 text-left text-slate-400 font-medium uppercase tracking-wider">Status</th>
          </tr>
        </thead>
        <tbody id="log-body"></tbody>
      </table>
    </div>
  </div>
</body>
<script src="/socket.io/socket.io.js"></script>
<script src="/js/main.js">
</script>