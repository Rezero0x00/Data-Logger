<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<title>Lab Monitoring System</title>
<link href="/css/output.css" rel="stylesheet">
</head>
<body class="min-h-screen bg-slate-100 flex items-center justify-center">

  <div class="w-[380px] p-4 space-y-3">

    <!-- Header -->
    <div class="text-center mb-2">
      <h1 class="text-lg font-semibold text-slate-800">Lab Monitoring System</h1>
      <p class="text-xs text-slate-400 uppercase tracking-widest">Realtime Environment Dashboard</p>
    </div>

    <!-- Grid: Temp + Humidity -->
    <div class="grid grid-cols-2 gap-3">

      <!-- Temperature -->
      <div class="bg-white rounded-2xl p-4 border border-slate-200 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-1 h-full bg-red-400 rounded-l-2xl"></div>
        <div class="w-9 h-9 rounded-xl bg-red-50 flex items-center justify-center mb-3 ml-1">
          <span class="text-lg">🌡️</span>
        </div>
        <p class="text-xs text-slate-400 uppercase tracking-wider ml-1 mb-1">Temperature</p>
        <p class="text-2xl font-bold text-slate-800 ml-1">
          <span id="temp">--</span><span class="text-sm font-normal text-slate-400"> °C</span>
        </p>
        <p class="text-xs text-red-400 ml-1 mt-1" id="temp-delta">—</p>
      </div>

      <!-- Humidity -->
      <div class="bg-white rounded-2xl p-4 border border-slate-200 relative overflow-hidden">
        <div class="absolute top-0 left-0 w-1 h-full bg-blue-400 rounded-l-2xl"></div>
        <div class="w-9 h-9 rounded-xl bg-blue-50 flex items-center justify-content-center flex items-center justify-center mb-3 ml-1">
          <span class="text-lg">💧</span>
        </div>
        <p class="text-xs text-slate-400 uppercase tracking-wider ml-1 mb-1">Humidity</p>
        <p class="text-2xl font-bold text-slate-800 ml-1">
          <span id="hum">--</span><span class="text-sm font-normal text-slate-400"> %</span>
        </p>
        <p class="text-xs text-blue-400 ml-1 mt-1" id="hum-delta">—</p>
      </div>
    </div>

    <!-- Pressure (wide) -->
    <div class="bg-white rounded-2xl p-4 border border-slate-200 relative overflow-hidden flex items-center gap-4">
      <div class="absolute top-0 left-0 w-1 h-full bg-violet-400 rounded-l-2xl"></div>
      <div class="w-9 h-9 rounded-xl bg-violet-50 flex items-center justify-center flex-shrink-0 ml-1">
        <span class="text-lg">🌬️</span>
      </div>
      <div class="flex-1">
        <p class="text-xs text-slate-400 uppercase tracking-wider mb-1">Pressure</p>
        <p class="text-2xl font-bold text-slate-800">
          <span id="press">--</span><span class="text-sm font-normal text-slate-400"> hPa</span>
        </p>
      </div>
      <div class="flex-[1.5]">
        <div class="flex justify-between items-center mb-1">
          <span class="text-xs text-slate-400">Range</span>
          <span class="text-xs text-slate-500" id="press-pct">--</span>
        </div>
        <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
          <div id="press-bar" class="h-full bg-violet-400 rounded-full transition-all duration-1000" style="width:0%"></div>
        </div>
        <div class="flex justify-between mt-1">
          <span class="text-[10px] text-slate-300">950</span>
          <span class="text-[10px] text-slate-300">1050</span>
        </div>
      </div>
    </div>

    <!-- Status bar -->
    <div class="bg-white rounded-2xl px-4 py-3 border border-slate-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs text-slate-500">Live Connected</span>
      </div>
      <span class="text-xs text-slate-300" id="last-update">Waiting for data...</span>
    </div>

  </div>

<script src="/socket.io/socket.io.js"></script>
<script>
  let prev = {};

  function fmt(v) {
    return v !== undefined ? v.toFixed(1) : '--';
  }

  function delta(cur, old, unit) {
    if (old === undefined) return '—';
    const d = cur - old;
    if (Math.abs(d) < 0.05) return '→ stable';
    return (d > 0 ? '↑ +' : '↓ ') + Math.abs(d).toFixed(1) + unit;
  }

  function update(data) {
    document.getElementById('temp').textContent  = fmt(data.temperature);
    document.getElementById('hum').textContent   = fmt(data.humidity);
    document.getElementById('press').textContent = fmt(data.pressure);

    document.getElementById('temp-delta').textContent = delta(data.temperature, prev.temperature, '°');
    document.getElementById('hum-delta').textContent  = delta(data.humidity,    prev.humidity,    '%');

    const pct = Math.round(Math.max(0, Math.min(100, (data.pressure - 950) / 100 * 100)));
    document.getElementById('press-bar').style.width = pct + '%';
    document.getElementById('press-pct').textContent = pct + '%';

    const now = new Date();
    document.getElementById('last-update').textContent = 'Updated ' + now.toLocaleTimeString();

    prev = { ...data };
  }

  const socket = io();
  socket.on('sensor-update', update);
</script>
</body>
</html>
